  "narrative": {
    "northStar": "Feierabend im Pixelhof",
    "overview": "The visual world is a rainy industrial evening: midnight petrol and cobalt surroundings, orange lamplight, ivory pixel lettering, and mint signals of successful help. Dennis stays friendly, capable, and affectionately portrayed; the dark setting creates atmosphere without turning customers into enemies to kill.\n\nThe user selected image 3, the detailed retro pixel world, as the art reference. It is not a complete UI composition. The shipped interface translates that world into square, readable game panels, concise German copy, tactile controls, and a viewport dominated by the yard.",
    "keyCharacteristics": [
      "Detailed retro pixel environment with crisp native-alpha character sprites.",
      "Dark blue panels, orange actions, and mint successful-help feedback.",
      "Pixel display type paired with readable system body type.",
      "Responsive game overlays and focused upgrade choices."
    ],
    "rules": [
      {
        "name": "The Helpful Color Rule",
        "body": "Orange invites action; mint marks patience and successful help. Low patience changes to a warm coral warning and retains its numeric percentage.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Pixel type carries identity and short game moments; system sans-serif carries instructions and sustained reading.",
        "section": "typography"
      },
      {
        "name": "The Readable Night Rule",
        "body": "Darken scenery beneath text and use bordered panels for information; do not rely on ambient card shadows to separate controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the selected retro pixel art and Dennis’ friendly character.",
      "Do use orange for actions and mint for successful help, patience, and experience pickups.",
      "Do keep body copy in the system sans-serif and pixel lettering for prominent game identity and short headings.",
      "Do retain visible keyboard focus, semantic buttons, and the upgrade modal’s focus handling.",
      "Do preserve native sprite alpha and disable image smoothing when drawing the game.",
      "Do retain reduced-motion handling for rain, bobbing, exit pulsing, and CSS transitions."
    ],
    "donts": [
      "Don’t treat image 3 as a measured web UI layout.",
      "Don’t replace square panels with rounded generic dashboard cards.",
      "Don’t use pixel lettering for every paragraph or obscure controls beneath scenery.",
      "Don’t depict Dennis negatively or make customers’ departure read as death.",
      "Don’t add opaque sprite backplates or smooth the pixel artwork."
    ]
  }
